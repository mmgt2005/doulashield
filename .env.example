# ============================================================
# Environment
# ============================================================
ENVIRONMENT=development

# ============================================================
# Supabase
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# SERVER ONLY — never expose to the frontend or commit this value
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================
# Database (direct connection — used by Alembic for migrations)
# ============================================================
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

# ============================================================
# JWT
# ============================================================
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# Application-layer encryption (Medicaid ID field)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotate every 90 days using MultiFernet
# ============================================================
FERNET_KEY=your-fernet-key-here

# ============================================================
# CORS — backend accepts requests only from this origin
# ============================================================
FRONTEND_ORIGIN=http://localhost:3000

# ============================================================
# Rate limiting
# ============================================================
RATE_LIMIT_AUTH=10/minute
REDIS_URL=redis://localhost:6379/0

# ============================================================
# Frontend — variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# NEVER put SUPABASE_SERVICE_ROLE_KEY or FERNET_KEY in a NEXT_PUBLIC_ var.
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
