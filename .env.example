# ============================================================
# Environment
# ============================================================
ENVIRONMENT=development

# ============================================================
# Supabase
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# SERVER ONLY — never expose to the frontend or commit this value
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================
# Database (direct connection — used by Alembic for migrations)
# ============================================================
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres

# ============================================================
# JWT
# ============================================================
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================
# Application-layer encryption (Medicaid ID field)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotate every 90 days using MultiFernet
# ============================================================
FERNET_KEY=your-fernet-key-here

# ============================================================
# CORS — backend accepts requests only from this origin
# ============================================================
FRONTEND_ORIGIN=http://localhost:3000

# ============================================================
# Rate limiting
# ============================================================
RATE_LIMIT_AUTH=10/minute
REDIS_URL=redis://localhost:6379/0

# ============================================================
# OCR / Document scanning (SERVER ONLY — never expose to the frontend)
# Requires an Anthropic BAA before using in production with PHI.
# ============================================================
ANTHROPIC_API_KEY=your-anthropic-api-key-here
SUPABASE_STORAGE_BUCKET=client-documents

# ============================================================
# Stripe billing (SERVER ONLY)
# ============================================================
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_DEPOSIT_PRICE_ID=price_...
STRIPE_MONTHLY_PRICE_ID=price_...
# Partner revenue split — set to Partner B's connected account ID (acct_...)
# Leave blank to disable automatic revenue splitting
STRIPE_PARTNER_ACCOUNT_ID=acct_...
STRIPE_PARTNER_SHARE=0.35

# ============================================================
# Resend email (SERVER ONLY)
# ============================================================
RESEND_API_KEY=re_...
EMAIL_FROM=DoulaShield <noreply@doulashield.com>

# ============================================================
# External services
# ============================================================
BACKEND_URL=https://your-backend.railway.app
ZIPZIGN_WEBHOOK_SECRET=
ZIPZIGN_BASE_URL=https://zipzign.com

# ============================================================
# Frontend — variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# NEVER put SUPABASE_SERVICE_ROLE_KEY or FERNET_KEY in a NEXT_PUBLIC_ var.
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_RADAR_API_KEY=
# Server-side Radar key for ZIP+4 enrichment at PDF generation time (must be the *secret* key prj_live_sk_…)
RADAR_API_KEY=
# USPS Web Tools — free ZIP+4 address verification fallback
# Register at: https://www.usps.com/business/web-tools-apis/
USPS_USER_ID=
